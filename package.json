{
  "name": "mtg-arena-edh",
  "private": true,
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:quick": "vitest run --exclude \"tests/simulation/**\" --tags-filter=\"!game\"",
    "test:games": "vitest run --tags-filter=game",
    "fetch-cards": "node scripts/fetch-cards.mjs",
    "fetch-corpus": "node scripts/fetch-corpus.mjs",
    "fetch-rules": "node scripts/fetch-rules.mjs",
    "parse-report": "node scripts/parse-report.mjs",
    "card-requests": "node scripts/card-requests.mjs",
    "recheck-requests": "node scripts/recheck-requests.mjs",
    "build:single": "tsc --noEmit && vite build --mode single",
    "build:exe": "npm run build && tsc -p launcher && node scripts/build-exe.mjs",
    "launcher": "tsc -p launcher && node scripts/build-exe.mjs --bundle-only && node dist-exe/launcher.cjs",
    "profile-game": "node scripts/profile-game.mjs"
  },
  "dependencies": {
    "immer": "^11.1.21",
    "mana-font": "^1.18.0",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  }
}
